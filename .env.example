# Planned application configuration contract; the product is not implemented yet.
# Keep real values in an untracked .env or deployment secret store.
APP_ENV=development
# local = no login (development only). accounts = people sign up and sign in; each sees only their own reviews.
AUTH_MODE=local
# In production (AUTH_MODE=accounts) set SECRET_KEY (32+ characters).
SECRET_KEY=
# Optional: Google OAuth Web client ID; enables "Continue with Google"
GOOGLE_CLIENT_ID=
# true = load the synthetic metformin demo review on start if it isn't there yet
SEED_DEMO=false
BIND_HOST=127.0.0.1
DATA_DIR=./data
# SQLite for local work, or a Neon Postgres connection string (use the pooled one at runtime;
# migrations prefer DATABASE_URL_UNPOOLED when it is set)
DATABASE_URL=sqlite:///./data/review.sqlite
CHECKPOINT_DATABASE=./data/checkpoints.sqlite
ALLOWED_ORIGINS=http://localhost:5173
NCBI_TOOL=mini_rayyan
# Fill with the team's registered contact; do not invent an address.
NCBI_EMAIL=
NCBI_API_KEY=
SOURCE_IMPORT_CAP=200
SOURCE_CONNECT_TIMEOUT_SECONDS=5
SOURCE_READ_TIMEOUT_SECONDS=30
SOURCE_MAX_ATTEMPTS=3
LLM_ENABLED=false
RAG_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_ALIAS=
LLM_MAX_CALLS_PER_TASK=3
LLM_TASK_TIMEOUT_SECONDS=45
RAG_MAX_RETRIEVAL_ROUNDS=2
RAG_MAX_CHUNKS_PER_ROUND=8
RAG_MAX_INPUT_CHARACTERS=12000
# No external tracing by default. Keep source text/private notes out of traces.
LANGSMITH_TRACING=false
